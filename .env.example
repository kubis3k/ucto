# Vercel/webová verze — nastavte tyto proměnné v Project Settings > Environment Variables.
# Desktop appka (Electron) žádné z těchto proměnných nepotřebuje — funguje bez nich (sql.js + auto-generovaný JWT_SECRET).

# Postgres connection string (Neon, Supabase, nebo jiný hostitel). Bez ní appka
# spadne zpátky na sql.js, což na Vercelu nemá trvalé úložiště.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Tajný klíč pro podepisování přihlašovacích tokenů. Vygenerujte např.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# mock = testovací ověření jednatele bez reálného BankID (výchozí, pokud nenastaveno).
# live = reálné OIDC přihlášení přes bankid.cz (viz app/server/lib/bankidOidc.js).
BANKID_MODE=mock

# Client ID/Secret z registrace aplikace na developer.bankid.cz (Credentials > Keys).
# NIKDY nevkládat přímo do kódu/gitu — jen jako env proměnná v Vercel dashboardu.
BANKID_CLIENT_ID=
BANKID_CLIENT_SECRET=

# Musí být přesně stejná hodnota, jakou máte zaregistrovanou jako "Redirect URI"
# v BankID admin konzoli — jinak OIDC flow spadne na redirect_uri_mismatch.
BANKID_REDIRECT_URI=https://globaalelevate.com

# Sandbox (výchozí, pokud nenastaveno) vs produkční BankID prostředí.
BANKID_ISSUER=https://oidc.sandbox.bankid.cz
