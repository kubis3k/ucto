# Vercel/webová verze — nastavte tyto proměnné v Project Settings > Environment Variables.
# Desktop appka (Electron) žádné z těchto proměnných nepotřebuje — funguje bez nich (sql.js + auto-generovaný JWT_SECRET).

# Postgres connection string (Neon, Supabase, nebo jiný hostitel). Bez ní appka
# spadne zpátky na sql.js, což na Vercelu nemá trvalé úložiště.
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Tajný klíč pro podepisování přihlašovacích tokenů. Vygenerujte např.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# mock = testovací ověření jednatele bez reálného BankID (výchozí, pokud nenastaveno).
# live = reálné OIDC přihlášení přes bankid.cz (viz app/server/lib/bankidOidc.js).
BANKID_MODE=mock

# Client ID/Secret z registrace aplikace na developer.bankid.cz (Credentials > Keys).
# NIKDY nevkládat přímo do kódu/gitu — jen jako env proměnná v Vercel dashboardu.
BANKID_CLIENT_ID=
BANKID_CLIENT_SECRET=

# Musí být přesně stejná hodnota, jakou máte zaregistrovanou jako "Redirect URI"
# v BankID admin konzoli — jinak OIDC flow spadne na redirect_uri_mismatch.
BANKID_REDIRECT_URI=https://ucto.globaalelevate.com

# Sandbox (výchozí, pokud nenastaveno) vs produkční BankID prostředí.
BANKID_ISSUER=https://oidc.sandbox.bankid.cz

# SMTP pro odesílání vydaných faktur e-mailem (tlačítko "Odeslat e-mailem" u
# faktury). Bez těchto proměnných tlačítko vrátí jasnou chybu, nic se tiše
# nesimuluje. Funguje s jakýmkoliv SMTP providerem (Seznam, Gmail app
# password, Resend, SendGrid SMTP relay, ...).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Postmark Inbound — pro automatické zaznamenání bankovních notifikačních
# e-mailů jako bankovní pohyb (Nastavení -> "Vygenerovat párovací adresu").
# POSTMARK_INBOUND_TOKEN je heslo mezi Postmarkem a naším serverem (Basic
# Auth v URL webhooku, vymyslete si vlastní silný token).
POSTMARK_INBOUND_TOKEN=

# Adresa se sestaví DVĚMA způsoby — použije se ten, který je nastavený
# (POSTMARK_INBOUND_DOMAIN má přednost):
#
# POSTMARK_INBOUND_DOMAIN — vlastní subdoména s MX záznamem na Postmark
# ("Inbound Domain Forwarding" v Postmark nastavení), např. in.vasedomena.cz.
# Adresa vyjde jako "token@in.vasedomena.cz" BEZ "+" — nutné, pokud banka
# u upozornění na pohyby odmítá "+" v e-mailu jako neplatný formát (ověřeno
# u Raiffeisenbank, 2026-07-20). Doporučeno.
POSTMARK_INBOUND_DOMAIN=

# POSTMARK_INBOUND_ADDRESS — výchozí Postmark adresa (Servers -> váš server
# -> Inbound), např. "abc123@inbound.postmarkapp.com". Adresa vyjde jako
# "abc123+token@inbound.postmarkapp.com" (Postmark "+" MailboxHash routing)
# — jednodušší na nastavení (žádná DNS změna), ale některé banky "+" odmítají.
POSTMARK_INBOUND_ADDRESS=

# Read-only GitHub PAT (jen "Contents: Read" na repo kubis3k/ucto) — používá se
# k proxy stažení instalátoru desktop appky (Windows/Mac) z nejnovějšího GitHub
# Release, protože repo je privátní a odkaz na asset by jinak vyžadoval vlastní
# token u klienta. Může to být STEJNÝ token, který se ručně kopíruje do
# desktop-config.json appky pro electron-updater — obojí potřebuje jen Contents:Read.
GITHUB_RELEASES_TOKEN=

# Vercel Blob — trvalé úložiště příloh dokladů (§ 8 ZoÚ, průkaznost).
# BEZ této proměnné se přílohy ukládají na lokální disk, což na Vercelu
# znamená DOČASNÝ disk serverless funkce — příloha po zhasnutí instance zmizí.
# Na produkci je proto POVINNÁ. Získá se ve Vercel dashboardu:
# Storage -> Create Blob store (token se do projektu přidá automaticky).
# Lokální vývoj a desktop ji nepotřebují — bez ní se použije filesystem.
BLOB_READ_WRITE_TOKEN=
