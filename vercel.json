{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/", "destination": "/app/renderer/index.html" },
    { "source": "/login", "destination": "/app/renderer/index.html" },
    { "source": "/tos", "destination": "/app/renderer/tos.html" },
    { "source": "/privacy-policy", "destination": "/app/renderer/privacy-policy.html" },
    { "source": "/app.js", "destination": "/app/renderer/app.js" },
    { "source": "/style.css", "destination": "/app/renderer/style.css" },
    { "source": "/sw.js", "destination": "/app/renderer/sw.js" },
    { "source": "/assets/(.*)", "destination": "/app/renderer/assets/$1" },
    { "source": "/pay/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/cron/recurring", "schedule": "0 6 * * *" }
  ]
}
