{
  "name": "globaal-elevate-ucetnictvi",
  "version": "1.0.0",
  "description": "Nezávislý účetní systém pro Globaal Elevate Production s.r.o. — podvojné účetnictví, daňová evidence a DPH modul podle českého práva.",
  "main": "main.js",
  "author": "Globaal Elevate Production s.r.o.",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dev:server": "node server/index.js",
    "dev:renderer": "node dev-static-server.js",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --win dir"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^6.9.16",
    "pdf-parse": "^1.1.4",
    "pdfkit": "^0.15.2",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "sql.js": "^1.14.1",
    "stripe": "^22.3.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.globaalelevate.ucetnictvi",
    "productName": "Globaal Elevate Ucetnictvi",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server/**/*",
      "renderer/**/*",
      "node_modules/**/*",
      "!node_modules/electron-builder/**/*",
      "!node_modules/electron/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/sql.js/dist/sql-wasm.wasm",
        "to": "sql-wasm.wasm"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "signDlls": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
